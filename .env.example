# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxx
GITHUB_USERNAME=your-username

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Oldest Ollama release this project has been validated against — below it the
# pipeline warns (older releases differ on tool calling and context handling).
DEVFACTORY_MIN_OLLAMA_VERSION=0.33.0
# Pull registry models Ollama is missing, at the start of a run. Set to false on
# a metered or offline host.
DEVFACTORY_AUTO_PULL_MODELS=true

# DevFactory settings
DEVFACTORY_POLL_INTERVAL=60          # seconds between GitHub polls
DEVFACTORY_DB_PATH=./devfactory.db
DEVFACTORY_WORKSPACE=/tmp/devfactory  # where repos are cloned
DEVFACTORY_MAX_VERIFICATION_RETRIES=3
DEVFACTORY_LOG_LEVEL=INFO


# OpenCode CLI — the harness every agent runs through
OPENCODE_BIN=~/.opencode/bin/opencode
OPENCODE_TIMEOUT_S=1800

# Docker
DOCKER_TEST_IMAGE=devfactory-test:latest
