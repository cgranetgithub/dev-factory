# What ruff enforces, stated to the editor before the file is saved.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 100

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
# A trailing double space is a line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
