# The environment the verification gate runs in.
#
# It used to be `python:3.11-slim`, which made DevFactory's Python the candidate
# repository's Python. That is the wrong way round: a target declaring
# `requires-python = ">=3.12"` could never be installed here, so both mypy and
# pytest ended every run in the error state (issue #92). The image now ships
# **uv** and lets the repository decide — `uv python install <version>` at prepare
# time, with the version read from the target itself.
FROM python:3.13-slim

# uv, pinned: the image is evidence, and an image that installs "whatever uv was
# latest that morning" cannot be rebuilt to match a recorded run.
COPY --from=ghcr.io/astral-sh/uv:0.11.15 /uv /uvx /usr/local/bin/

# The git binary is not optional. GitPython — a runtime dependency of this project,
# and a common one in general — raises on import when it cannot find `git`, so a
# test module that imports it fails to *collect*, and pytest reports
# "0 passed, 0 failed" plus a collection error. The verification gate then fails
# every run of the repository regardless of what the developer produced.
# python:3.13-slim ships without it; GitHub Actions runners have it, which is how
# the divergence stayed invisible until it blocked four factory runs.
RUN apt-get update \
    && apt-get install --no-install-recommends -y git \
    && rm -rf /var/lib/apt/lists/*

# The verification tools live in the image's own Python — the one this FROM line
# pins — and never in the target's environment. That is the deliberate part:
#   - ruff and bandit judge source text and need nothing installed, so where they
#     run is irrelevant;
#   - mypy needs the target's *dependencies*, not the target's *interpreter*. It
#     gets them through `--python-executable`, which is exactly what that flag is
#     for, so the gate's own mypy version stays fixed across every target while
#     still resolving the real types (issue #77).
#   - pytest is the exception and cannot be one of these: it must import the code
#     under test and every plugin the target's suite declares, so it comes from
#     the target's environment (the prepare step adds it there when the target
#     brings none of its own).
# Installing our four tools into the target's venv instead would change what the
# target's suite sees — resolver outcomes, plugin autoloading, transitive pins —
# and the gate must observe the repository, not perturb it.
RUN uv pip install --system --no-cache \
    "ruff>=0.4.0" \
    "mypy>=1.10.0" \
    "bandit>=1.7.8"

# Interpreters for the targets, resolved and cached at build time. `uv python
# install` at prepare time is then a no-op for these versions; a target asking for
# one that is not here still works, it just pays the download once per container.
# This list is "what our repositories ask for": 3.11 (DevFactory's own floor),
# 3.12 (news-watch), 3.13, 3.14 (biz-explore's CI).
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python
RUN uv python install 3.11 3.12 3.13 3.14

# Copying rather than hardlinking: the prepare step installs into /build, which is
# a different filesystem layer from the cache, and uv warns on every package
# otherwise — noise in an output the developer agent has to read.
ENV UV_LINK_MODE=copy

WORKDIR /workspace

# GitPython also wants an identity before it will create a commit; a container has
# none, and a test that commits would fail with an unhelpful error.
RUN git config --global user.email "verification@devfactory.local" \
    && git config --global user.name "DevFactory Verification" \
    && git config --global init.defaultBranch main \
    && git config --global --add safe.directory '*'

# No CMD: every use of this image is a `docker run ... sh -c <command>` built by
# devfactory/verification/runner.py. The CMD that used to be here ran `pip install`
# on the read-only mount and could not have worked.
